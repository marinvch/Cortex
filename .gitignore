# ── Personal layer (never committed) — the "one privacy rule" ───────────
# Personal/business content stays local.
context/
inbox/
daily/
notes/
projects/
areas/
resources/
decisions/
brain/
# Your personalized dashboard. Forkers start from home.example.md (cp home.example.md home.md).
home.md

# Removed notes are archived here by cortex-rm.sh; they may carry personal content — never commit.
archives/removed/

# Keep folder placeholders + README templates tracked so the vault stays shareable
!context/.gitkeep
!decisions/.gitkeep
!inbox/README.md
!projects/README.md
!areas/README.md
!resources/README.md

# ── Local tool state ───────────────────────────────────────────────────
.env
.env.local
# Local /slash-command copies of the rituals; canonical skills live in skills/
.claude/skills/

# ── Legacy engine (retired, kept on disk; ignore its build output if run) ─
node_modules/
engine/node_modules/
engine/coverage/

# Generated views (contain personal note titles) — regenerate locally, never commit
cortex.html
brain.html
navigator.html
cortex-graph.html

# Backups (auto-created; noise — never commit)
*.bak
context/.backups/

# ── Vendored third-party skill collections (re-fetchable; keep the repo lean) ──
.agents/
.superpowers/
