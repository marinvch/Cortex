{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cortex: test",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "group": "test"
    },
    {
      "label": "cortex: build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "group": "build"
    },
    {
      "label": "cortex: validate",
      "type": "shell",
      "command": "npm",
      "args": ["run", "validate"]
    },
    {
      "label": "cortex: smoke",
      "type": "shell",
      "command": "npm",
      "args": ["run", "validate:smoke"]
    },
    {
      "label": "cortex: scorecard-check",
      "type": "shell",
      "command": "npm",
      "args": ["run", "scorecard:check"]
    },
    {
      "label": "cortex: quality-check",
      "dependsOn": ["cortex: test", "cortex: build", "cortex: scorecard-check"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
